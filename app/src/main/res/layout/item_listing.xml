<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/listingCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_16"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutline"
    app:strokeWidth="@dimen/outline_width">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.xiao.idealistachallenge.ui.media.AspectRatioFrameLayout
            android:id="@+id/listingMediaViewport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorSurfaceVariant"
            app:aspectRatio="16:9">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listingImagePager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:importantForAccessibility="yes"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/listingImagePosition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|bottom"
                android:layout_margin="@dimen/media_indicator_margin"
                android:background="?attr/colorSurfaceVariant"
                android:importantForAccessibility="no"
                android:paddingEnd="@dimen/media_indicator_horizontal_padding"
                android:paddingStart="@dimen/media_indicator_horizontal_padding"
                android:paddingVertical="@dimen/media_indicator_vertical_padding"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/supporting_text_size"
                android:visibility="gone"
                tools:text="1 / 3"
                tools:visibility="visible" />
        </com.xiao.idealistachallenge.ui.media.AspectRatioFrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/card_content_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/listingPrice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/listing_price_text_size"
                    android:textStyle="bold"
                    tools:text="125.000 €" />

                <ImageButton
                    android:id="@+id/favoriteButton"
                    android:layout_width="@dimen/min_interactive_target"
                    android:layout_height="@dimen/min_interactive_target"
                    android:layout_marginStart="@dimen/space_8"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/favorite_accessibility_save"
                    android:minWidth="@dimen/min_interactive_target"
                    android:minHeight="@dimen/min_interactive_target"
                    android:padding="@dimen/space_12"
                    android:src="@drawable/ic_favorite_border"
                    app:tint="@color/favorite_star_tint"
                    android:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/listingFacts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/supporting_text_size"
                tools:text="80 m² · 3 habitaciones · 2 baños" />

            <TextView
                android:id="@+id/listingHighlights"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/supporting_text_size"
                android:visibility="gone"
                tools:text="Exterior · A/C · Trastero · Garaje incluido"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/listingSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/card_title_text_size"
                tools:text="Piso en Centro, Madrid" />

            <TextView
                android:id="@+id/favoriteDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textSize="@dimen/supporting_text_size"
                android:visibility="gone"
                tools:text="Guardado el 26/08/2026"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
