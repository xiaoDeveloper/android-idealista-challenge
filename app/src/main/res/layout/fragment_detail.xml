<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detailScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    tools:context=".ui.detail.DetailFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/detailContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_32">

            <com.xiao.idealistachallenge.ui.media.AspectRatioFrameLayout
                android:id="@+id/detailMediaViewport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceVariant"
                app:aspectRatio="4:3">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/detailImagePager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:overScrollMode="never" />

                <TextView
                    android:id="@+id/detailImagePosition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="@dimen/media_indicator_margin"
                    android:background="@drawable/bg_detail_media_indicator"
                    android:importantForAccessibility="no"
                    android:paddingHorizontal="@dimen/media_indicator_horizontal_padding"
                    android:paddingVertical="@dimen/media_indicator_vertical_padding"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/supporting_text_size"
                    android:visibility="gone"
                    tools:text="1 / 10" />
            </com.xiao.idealistachallenge.ui.media.AspectRatioFrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_content_inset"
                android:paddingTop="@dimen/space_24"
                android:paddingEnd="@dimen/screen_content_inset">

                <TextView
                    android:id="@+id/detailPropertyTypeOperation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/supporting_text_size"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/detailPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/detail_price_text_size"
                    android:textStyle="bold"
                    tools:text="1.195.000 €" />

                <TextView
                    android:id="@+id/detailLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/body_text_size"
                    android:visibility="gone"
                    tools:text="calle de Lagasca, Castellana, Madrid" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/detailPrimaryFacts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:visibility="gone"
                    app:chipSpacingHorizontal="@dimen/space_8"
                    app:chipSpacingVertical="@dimen/space_8" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/detailSecondaryFacts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:visibility="gone"
                    app:chipSpacingHorizontal="@dimen/space_8"
                    app:chipSpacingVertical="@dimen/space_8" />

                <TextView
                    android:id="@+id/detailSavedState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:background="@drawable/bg_detail_saved_state"
                    android:paddingHorizontal="@dimen/space_12"
                    android:paddingVertical="@dimen/space_8"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:textSize="@dimen/supporting_text_size"
                    android:visibility="gone"
                    tools:text="Guardado el 28/08/2026" />

                <LinearLayout
                    android:id="@+id/detailCharacteristicsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_spacing"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/property_characteristics_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/card_title_text_size"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        app:cardBackgroundColor="?attr/colorSurface"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/colorOutline"
                        app:strokeWidth="@dimen/outline_width">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/card_content_padding">

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/detailCharacteristicTags"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:visibility="gone"
                                app:chipSpacingHorizontal="@dimen/space_8"
                                app:chipSpacingVertical="@dimen/space_8" />

                            <RelativeLayout
                                android:id="@+id/detailCommunityCostsRow"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_8"
                                android:visibility="gone">

                                <TextView
                                    android:id="@+id/detailCommunityCostsValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="@dimen/body_text_size"
                                    android:textStyle="bold"
                                    tools:text="330 €" />

                                <TextView
                                    android:id="@+id/detailCommunityCostsLabel"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="@dimen/space_8"
                                    android:layout_toStartOf="@id/detailCommunityCostsValue"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="@dimen/body_text_size"
                                    tools:text="Gastos de comunidad" />
                            </RelativeLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <TextView
                    android:id="@+id/detailDescriptionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_spacing"
                    android:text="@string/property_description_title"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/card_title_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detailDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/body_text_size" />

                <Button
                    android:id="@+id/detailDescriptionToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/min_interactive_target"
                    android:layout_marginTop="@dimen/space_4"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/description_expand_content_description"
                    android:minHeight="@dimen/min_interactive_target"
                    android:minWidth="@dimen/min_interactive_target"
                    android:text="@string/description_expand"
                    android:textColor="?attr/colorPrimary"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/detailEnergySection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_spacing"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/energy_certificate_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/card_title_text_size"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/detailEnergyConsumptionCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_4"
                            android:layout_weight="1"
                            android:visibility="gone"
                            app:cardBackgroundColor="?attr/colorSurface"
                            app:cardCornerRadius="@dimen/card_corner_radius"
                            app:cardElevation="0dp"
                            app:strokeColor="?attr/colorOutline"
                            app:strokeWidth="@dimen/outline_width">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="@dimen/space_12">

                                <TextView
                                    android:id="@+id/detailEnergyConsumptionLabel"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="@dimen/supporting_text_size"
                                    tools:text="Consumo" />

                                <TextView
                                    android:id="@+id/detailEnergyConsumptionValue"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_4"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="@dimen/card_title_text_size"
                                    android:textStyle="bold"
                                    tools:text="E" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/detailEnergyEmissionsCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_4"
                            android:layout_weight="1"
                            android:visibility="gone"
                            app:cardBackgroundColor="?attr/colorSurface"
                            app:cardCornerRadius="@dimen/card_corner_radius"
                            app:cardElevation="0dp"
                            app:strokeColor="?attr/colorOutline"
                            app:strokeWidth="@dimen/outline_width">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="@dimen/space_12">

                                <TextView
                                    android:id="@+id/detailEnergyEmissionsLabel"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="@dimen/supporting_text_size"
                                    tools:text="Emisiones" />

                                <TextView
                                    android:id="@+id/detailEnergyEmissionsValue"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_4"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="@dimen/card_title_text_size"
                                    android:textStyle="bold"
                                    tools:text="E" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/loadingState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_32">
        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/loading_detail" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/loading_detail"
            android:textSize="@dimen/body_text_size" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/errorState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_32"
        android:visibility="gone">
        <TextView
            android:id="@+id/errorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/error_detail_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/screen_title_text_size"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/errorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center"
            android:text="@string/error_detail_message"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/body_text_size" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_24"
            android:contentDescription="@string/content_description_retry"
            android:minHeight="@dimen/min_interactive_target"
            android:text="@string/retry" />
    </LinearLayout>
</FrameLayout>
