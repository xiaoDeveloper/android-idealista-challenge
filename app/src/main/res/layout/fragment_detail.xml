<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detailScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    tools:context=".ui.detail.DetailFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/detailContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_24">

            <com.xiao.idealistachallenge.ui.media.AspectRatioFrameLayout
                android:id="@+id/detailMediaViewport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceVariant"
                app:aspectRatio="4:3">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/detailImagePager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:overScrollMode="never" />

                <TextView
                    android:id="@+id/detailImagePlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/property_image_placeholder_content_description"
                    android:importantForAccessibility="yes"
                    android:text="@string/property_image_placeholder"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/detailImagePosition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="@dimen/media_indicator_margin"
                    android:background="?attr/colorSurfaceVariant"
                    android:importantForAccessibility="no"
                    android:paddingHorizontal="@dimen/media_indicator_horizontal_padding"
                    android:paddingVertical="@dimen/media_indicator_vertical_padding"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/supporting_text_size"
                    android:visibility="gone"
                    tools:text="1 / 10" />
            </com.xiao.idealistachallenge.ui.media.AspectRatioFrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_content_inset"
                android:paddingTop="@dimen/space_24"
                android:paddingEnd="@dimen/screen_content_inset">

                <TextView
                    android:id="@+id/detailPropertyTypeOperation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/supporting_text_size"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/detailPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/detail_price_text_size"
                    android:textStyle="bold"
                    tools:text="1.195.000 €" />

                <TextView
                    android:id="@+id/detailLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/body_text_size"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/detailEssentialFacts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/body_text_size"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/detailFavoriteButton"
                        android:layout_width="@dimen/min_interactive_target"
                        android:layout_height="@dimen/min_interactive_target"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/favorite_accessibility_save"
                        android:enabled="false"
                        android:minWidth="@dimen/min_interactive_target"
                        android:minHeight="@dimen/min_interactive_target"
                        android:padding="@dimen/space_12"
                        android:src="@android:drawable/btn_star_big_off"
                        app:tint="@color/favorite_star_tint" />

                    <TextView
                        android:id="@+id/detailFavoriteDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:layout_weight="1"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:textSize="@dimen/supporting_text_size"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/detailAdditionalCharacteristicsTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_spacing"
                    android:text="@string/property_characteristics_title"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/card_title_text_size"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/detailAdditionalCharacteristics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/body_text_size"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/detailDescriptionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_spacing"
                    android:text="@string/property_description_title"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/card_title_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detailDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/body_text_size" />

                <Button
                    android:id="@+id/detailDescriptionToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/min_interactive_target"
                    android:layout_marginTop="@dimen/space_4"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/description_expand_content_description"
                    android:minHeight="@dimen/min_interactive_target"
                    android:minWidth="@dimen/min_interactive_target"
                    android:text="@string/description_expand"
                    android:textColor="?attr/colorPrimary"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/detailEnergyTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_spacing"
                    android:text="@string/energy_certificate_title"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/card_title_text_size"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/detailEnergyConsumption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/body_text_size"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/detailEnergyEmissions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/body_text_size"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/detailStaticResponseNotice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_spacing"
                    android:text="@string/detail_static_response_notice"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/supporting_text_size" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/loadingState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_32">
        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/loading_detail" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/loading_detail"
            android:textSize="@dimen/body_text_size" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/errorState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_32"
        android:visibility="gone">
        <TextView
            android:id="@+id/errorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/error_detail_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/screen_title_text_size"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/errorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center"
            android:text="@string/error_detail_message"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/body_text_size" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_24"
            android:contentDescription="@string/content_description_retry"
            android:minHeight="@dimen/min_interactive_target"
            android:text="@string/retry" />
    </LinearLayout>
</FrameLayout>
