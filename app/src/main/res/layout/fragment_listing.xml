<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/listingScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    tools:context=".ui.listing.ListingFragment">

    <LinearLayout
        android:id="@+id/listingContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_content_inset"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/screen_content_inset"
        android:paddingBottom="@dimen/space_16"
        android:visibility="gone">

        <TextView
            android:id="@+id/resultsCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/supporting_text_size"
            tools:text="4 viviendas disponibles" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listingRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/space_16"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_listing" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/loadingState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_32">

        <ProgressBar
            android:id="@+id/loadingProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/loading_list"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/loadingMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/loading_list"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/body_text_size" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_32"
        android:visibility="gone">

        <TextView
            android:id="@+id/emptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/empty_list_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/screen_title_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/emptyMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center"
            android:text="@string/empty_list_message"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/body_text_size" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/errorState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_32"
        android:visibility="gone">

        <TextView
            android:id="@+id/errorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/error_list_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/screen_title_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/errorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center"
            android:text="@string/error_list_message"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/body_text_size" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_24"
            android:contentDescription="@string/content_description_retry"
            android:minHeight="@dimen/min_interactive_target"
            android:text="@string/retry" />
    </LinearLayout>
</FrameLayout>
