<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/listingFragment">

    <fragment
        android:id="@+id/listingFragment"
        android:name="com.xiao.idealistachallenge.ui.listing.ListingFragment"
        android:label="@string/listing_title">
        <action
            android:id="@+id/action_listingFragment_to_detailFragment"
            app:destination="@id/detailFragment" />
    </fragment>

    <fragment
        android:id="@+id/detailFragment"
        android:name="com.xiao.idealistachallenge.ui.detail.DetailFragment"
        android:label="@string/detail_title">
        <!-- selectedAdId is local context only; detail.json remains the official fixed endpoint. -->
        <argument
            android:name="selectedAdId"
            app:argType="string" />
    </fragment>
</navigation>
